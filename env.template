# Copy this file to .env. Do not commit .env.

# Discord bot process
DISCORD_BOT_TOKEN=replace-me
API_BASE_URL=http://localhost:8000
QUESTION_TIMEOUT_SECONDS=10

# Shared key for the bot-only question endpoint. Optional for local development;
# set the same non-empty value on the API and bot in production.
BOT_API_KEY=

# Django API and admin
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave DB_HOST empty to use local SQLite. Set all five fields for PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
